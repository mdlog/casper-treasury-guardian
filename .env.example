# ---- Casper testnet deployment (Odra livenet) ----
# Path to your funded testnet secret key (PEM). Generate with:
#   casper-client keygen ./keys
# then fund the public key at https://testnet.cspr.live/tools/faucet
ODRA_CASPER_LIVENET_SECRET_KEY_PATH=./keys/secret_key.pem

# Node RPC. Use the local CSPR.cloud proxy (see cspr_proxy.js):
ODRA_CASPER_LIVENET_NODE_ADDRESS=http://127.0.0.1:7778/rpc
ODRA_CASPER_LIVENET_CHAIN_NAME=casper-test

# CSPR.cloud API token (create one at https://console.cspr.build/).
# Consumed only by cspr_proxy.js, never sent anywhere else.
CSPR_CLOUD_AUTH_TOKEN=

# ---- Deployed contract (filled in after deploy_testnet succeeds) ----
# Package hash of the vault, e.g. contract-package-....  Used by tg_cli,
# the agent and the dashboard backend.
TG_CONTRACT_ADDRESS=

# ---- Optional deploy-time policy (CSPR; deploy_testnet reads these) ----
# TG_DAILY_CAP_CSPR=1000
# TG_AUTO_THRESHOLD_CSPR=100
# TG_COOLDOWN_MS=0
# TG_AGENT_PUBLIC_KEY=        # defaults to the deployer

# ---- Agent / x402 ----
MOCK_API_URL=http://localhost:4021
X402_RESOURCE=/api/market-intel
# Reserve account the agent rebalances into (should be on the allowlist):
TG_RESERVE_ACCOUNT=
