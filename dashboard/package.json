{
  "name": "treasury-guardian-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner dashboard: view vault state, edit policy, approve/veto queued agent actions.",
  "scripts": {
    "server": "tsx watch server/index.ts",
    "dev": "vite",
    "start": "concurrently -n server,web -c blue,green \"npm:server\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
